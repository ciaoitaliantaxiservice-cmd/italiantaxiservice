---
/**
 * "Our coverage across Italy": a full-width map centred on Rome with the
 * main cities and airports, and an overlay card with a quote action.
 *
 * Leaflet + OpenStreetMap tiles: no API key, no cookies. Leaflet (about 40 KB
 * gzipped with its CSS) is only fetched when the section comes within 400px
 * of the viewport, so it never touches the first paint or Lighthouse's
 * initial load. The same cities and airports are listed in the markup for
 * screen readers and for anyone without JavaScript.
 *
 * OSM's public tiles are fine for a small site with attribution (shown in
 * the corner). If traffic grows, swap TILE_URL for a commercial provider:
 * see README, "Coverage map".
 */
import Icon from './Icon.astro';
import { t } from '../data/content';
import type { Lang } from '../data/i18n';
import { coverageCities, coverageAirports, MAP_CENTER, MAP_ZOOM } from '../data/coverage';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).contact.coverage;

const config = {
  center: MAP_CENTER,
  zoom: MAP_ZOOM,
  cities: coverageCities.map((p) => ({ name: p.name[lang], lat: p.lat, lng: p.lng, main: p.id === 'rome' })),
  airports: coverageAirports.map((p) => ({ name: p.name[lang], lat: p.lat, lng: p.lng })),
};
---

<section class="coverage" aria-labelledby="coverage-heading">
  <div class="wrap">
    <div class="coverage__head">
      <p class="eyebrow eyebrow--on-dark">
        <span class="label">{c.eyebrow}</span>
      </p>
      <h2 id="coverage-heading">{c.heading}</h2>
      <p>{c.intro}</p>
    </div>

    <div class="coverage__frame">
      <div
        class="coverage__map"
        id="coverage-map"
        role="region"
        aria-label={c.mapLabel}
        data-config={JSON.stringify(config)}
      >
      </div>

      <div class="coverage__card">
        <p class="coverage__kicker">
          <Icon name="plane" />
          <span>{c.cardKicker}</span>
        </p>
        <h3>{c.cardTitle}</h3>
        <p>{c.cardBody}</p>
        <a class="btn btn--primary" href="#quote-form">
          <Icon name="tag" />
          {c.cardCta}
        </a>
      </div>
    </div>

    {/* The places on the map, as text: read by screen readers, and shown
        instead of the map when JavaScript is off. */}
    <div class="coverage__lists" data-coverage-lists>
      <div>
        <h3>{c.citiesLabel}</h3>
        <ul>{coverageCities.map((p) => <li>{p.name[lang]}</li>)}</ul>
      </div>
      <div>
        <h3>{c.airportsLabel}</h3>
        <ul>{coverageAirports.map((p) => <li>{p.name[lang]}</li>)}</ul>
      </div>
    </div>
  </div>

  {/* Marker artwork, cloned by the script: the brand pin for cities and a
      Lucide plane for airports. */}
  <template id="coverage-plane"><Icon name="plane" /></template>

  {/* Without JavaScript there is no map: show the lists instead. */}
  <noscript>
    <style is:inline>
      .coverage__map { display: none; }
      .coverage__lists { position: static; width: auto; height: auto; clip-path: none; white-space: normal; display: grid; gap: 1.5rem; margin-top: 2rem; color: #F4F5F0; }
      .coverage__lists h3 { color: #FFFFFF; }
    </style>
  </noscript>
</section>

<script>
  import type * as Leaflet from 'leaflet';

  interface MapPlace {
    name: string;
    lat: number;
    lng: number;
    main?: boolean;
  }
  interface MapConfig {
    center: { lat: number; lng: number };
    zoom: { phone: number; wide: number };
    cities: MapPlace[];
    airports: MapPlace[];
  }

  const TILE_URL = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';
  const ATTRIBUTION =
    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors';

  const el = document.getElementById('coverage-map');

  async function start(node: HTMLElement) {
    const [{ default: L }] = await Promise.all([
      import('leaflet') as Promise<{ default: typeof Leaflet }>,
      import('leaflet/dist/leaflet.css'),
    ]);
    const cfg: MapConfig = JSON.parse(node.dataset.config ?? '{}');
    const wide = window.matchMedia('(min-width: 48rem)').matches;
    const plane = (document.getElementById('coverage-plane') as HTMLTemplateElement | null)?.innerHTML ?? '';

    const map = L.map(node, {
      center: [cfg.center.lat, cfg.center.lng],
      zoom: wide ? cfg.zoom.wide : cfg.zoom.phone,
      // Whole zoom steps only: fractional zoom scales the tiles and leaves
      // hairline seams between them.
      zoomSnap: 1,
      minZoom: 5,
      maxZoom: 12,
      scrollWheelZoom: false, // the page scrolls past the map, not into it
      dragging: !L.Browser.mobile, // one finger scrolls the page on phones
      zoomControl: false,
      fadeAnimation: false,
      attributionControl: true,
    });
    map.attributionControl.setPrefix('<a href="https://leafletjs.com">Leaflet</a>');
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    L.tileLayer(TILE_URL, { attribution: ATTRIBUTION, maxZoom: 19 }).addTo(map);

    // Frame mainland Italy, Rome at its heart, in the part of the map the
    // overlay card leaves free (the card floats top-left from 48rem).
    const card = node.parentElement?.querySelector<HTMLElement>('.coverage__card');
    const cardRight = wide && card ? card.offsetLeft + card.offsetWidth : 0;
    const places = [...cfg.cities, ...cfg.airports];
    map.fitBounds(L.latLngBounds(places.map((p) => [p.lat, p.lng] as [number, number])), {
      // Tight padding on phones, where every pixel decides the zoom step.
      paddingTopLeft: wide ? [cardRight + 24, 32] : [12, 12],
      paddingBottomRight: wide ? [24, 24] : [12, 12],
      maxZoom: 7,
    });

    // Airports first and below; cities drawn on top so no pin is hidden.
    for (const p of cfg.airports) {
      L.marker([p.lat, p.lng], {
        title: p.name,
        keyboard: true,
        icon: L.divIcon({ className: 'cov-air', html: plane, iconSize: [22, 22] }),
      })
        .bindTooltip(p.name, { direction: 'top', offset: [0, -11], className: 'cov-tip' })
        .addTo(map);
    }

    for (const p of cfg.cities) {
      L.marker([p.lat, p.lng], {
        title: p.name,
        keyboard: true,
        riseOnHover: true,
        zIndexOffset: p.main ? 2000 : 1000,
        icon: L.divIcon({
          className: `cov-pin${p.main ? ' cov-pin--main' : ''}`,
          html: '<span></span>',
          iconSize: p.main ? [22, 22] : [16, 16],
        }),
      })
        .bindTooltip(p.name, {
          direction: 'top',
          offset: [0, -10],
          permanent: !!p.main,
          className: 'cov-tip',
        })
        .addTo(map);
    }

    node.classList.add('is-ready');
  }

  if (el) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          start(el).catch(() => el.classList.add('is-failed'));
        }
      },
      { rootMargin: '400px' }
    );
    io.observe(el);
  }
</script>
