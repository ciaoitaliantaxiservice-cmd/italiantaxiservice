---
import { LANGS, ui, htmlLang, langNames, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
  /** Path of the equivalent page in each language — never a bare homepage link. */
  paths: Record<Lang, string>;
}

const { lang, paths } = Astro.props;
const labels: Record<Lang, string> = { en: 'EN', it: 'IT' };
---

<nav class="lang-switch" aria-label={ui[lang].switchLanguage}>
  {
    LANGS.map((l) => (
      <a
        class="lang-switch__item"
        href={paths[l]}
        hreflang={htmlLang[l]}
        lang={htmlLang[l]}
        aria-current={l === lang ? 'true' : undefined}
      >
        <span aria-hidden="true">{labels[l]}</span>
        <span class="visually-hidden">{langNames[l]}</span>
      </a>
    ))
  }
</nav>
