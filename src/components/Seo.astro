---
import { site } from '../data/site.mjs';
import { absolute } from '../data/seo';
import { ogLocale, type Lang } from '../data/i18n';
import type { Alternate } from '../data/seo';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of THIS page, e.g. `/en/about/`. Becomes the self-referencing canonical. */
  path: string;
  /** Reciprocal set including this page itself plus one x-default. */
  alternates: Alternate[];
  noindex?: boolean;
  /** Open Graph image path relative to the site root. */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  lang,
  title,
  description,
  path,
  alternates,
  noindex = false,
  ogImage = '/images/og-default.svg',
  ogType = 'website',
} = Astro.props;

const canonical = absolute(path);
const ogImageUrl = absolute(ogImage);

// `follow` is kept on noindex pages so link equity still reaches the hub.
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />

<link rel="canonical" href={canonical} />

{/* Reciprocal hreflang. Every page in the group advertises the same set. */}
{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))
}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.brand} />
<meta property="og:locale" content={ogLocale[lang]} />
{
  alternates
    .filter((a) => a.hreflang !== 'x-default' && a.hreflang !== lang)
    .map((a) => <meta property="og:locale:alternate" content={ogLocale[a.hreflang as Lang]} />)
}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.brand} — ${description.slice(0, 80)}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
{/* [[ADD twitter:site ONCE AN X / TWITTER HANDLE EXISTS]] */}
