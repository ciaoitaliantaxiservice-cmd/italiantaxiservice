# Copy to .env.local for local builds. Never commit real values.

# --- Cloudflare Turnstile (contact form spam protection) -------------------
# Create a widget at Cloudflare dashboard -> Turnstile -> Add widget
# (mode: Managed or Invisible; hostnames: www.ciaoitaliantaxiservice.com,
# ciaoitaliantaxiservice.com, localhost).
#
# Site key: public. Read at BUILD time and written into the contact page.
#   Production: Cloudflare dashboard -> Workers & Pages -> italiantaxiservice
#   -> Settings -> Build -> Variables and secrets -> TURNSTILE_SITE_KEY.
TURNSTILE_SITE_KEY=your-turnstile-site-key

# Secret key: private. Used only by the contact-message Supabase Edge
# Function, so it lives in Supabase secrets, not in the website build:
#   npx -y supabase@3.1.0 secrets set --project-ref zuutmiilqhtqgfvowlns TURNSTILE_SECRET_KEY=...
# (Listed here only so local `supabase functions serve` has it.)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# For local testing only, Cloudflare's test keys always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
