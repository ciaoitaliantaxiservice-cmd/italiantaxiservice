---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { routes, navOrder, ui, type Lang, type RouteKey } from '../data/i18n';
import Icon from './Icon.astro';
import { site, emailHref } from '../data/site.mjs';

interface Props {
  lang: Lang;
  current?: RouteKey;
  /** Equivalent page in each language, for the EN/IT switch. */
  altPaths: Record<Lang, string>;
}

const { lang, current, altPaths } = Astro.props;
const l = ui[lang];
const quoteHref = `${routes.contact[lang]}#quote-form`;
---

{/* Utility bar: the thin dark strip above the header. Centred on phones;
    note left and email action right from 48rem. The address itself is not
    written out here (it is in the footer and on the contact page), just a
    short mailto action. */}
<div class="utility-bar">
  <div class="wrap utility-bar__inner">
    <span class="utility-bar__note">{l.utilityNote}</span>
    <a class="utility-bar__email" href={emailHref}>
      <Icon name="mail" />
      <span>{l.emailUs}</span>
    </a>
  </div>
</div>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="logo" href={routes.home[lang]}>
      {/* Header reading: plain ribbon, no lettering; the wordmark beside it
          names the link, so the mark itself is aria-hidden. */}
      <Logo />
      <span class="logo__text">
        <span class="logo__name">{site.brand}</span>
        <span class="logo__tag">{l.lockupTag}</span>
      </span>
    </a>

    {/* One nav for both layouts. From 68rem it is the inline row. Below
        that it is the full-screen menu: the top row (language switch and
        close button) and the actions at the foot only show there. */}
    <nav class="site-nav" id="site-nav" aria-label={l.mainNav} data-open="false">
      <div class="site-nav__top">
        <LangSwitch lang={lang} paths={altPaths} />
        <button class="nav-close" type="button" aria-controls="site-nav" data-nav-close>
          <Icon name="close" />
          <span>{l.closeMenu}</span>
        </button>
      </div>

      <ul class="site-nav__list">
        {
          navOrder.map((key) => (
            <li>
              <a href={routes[key][lang]} aria-current={key === current ? 'page' : undefined}>
                {l[key]}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="site-nav__actions">
        <a class="btn btn--primary" href={quoteHref}>
          <Icon name="tag" />
          {l.getQuote}
        </a>
        <a class="btn btn--outline" href={emailHref}>
          <Icon name="mail" />
          {l.emailUs}
        </a>
      </div>
    </nav>

    <div class="header__actions">
      <div class="header__lang">
        <LangSwitch lang={lang} paths={altPaths} />
      </div>

      <a class="btn btn--primary btn--header header__cta" href={quoteHref}>
        {l.getQuote}
      </a>

      <button
        class="nav-toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        data-nav-toggle
      >
        <Icon name="menu" />
        <span class="nav-toggle__label">{l.menu}</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Full-screen mobile menu. A real button with a correct aria-expanded
  // state; while open, focus stays inside the menu, the page behind does not
  // scroll, and Escape or the close button returns focus to Menu. Tapping a
  // link closes the menu at once, so the next page never opens with it up.
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const close = document.querySelector<HTMLButtonElement>('[data-nav-close]');
  const nav = document.getElementById('site-nav');
  const root = document.documentElement;
  const desktop = window.matchMedia('(min-width: 68rem)');

  if (toggle && close && nav) {
    const setOpen = (open: boolean, returnFocus = false) => {
      nav.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      root.classList.toggle('nav-open', open);
      if (open) close.focus();
      else if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false, true));

    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (nav.dataset.open !== 'true' || desktop.matches) return;
      if (e.key === 'Escape') {
        setOpen(false, true);
        return;
      }
      if (e.key !== 'Tab') return;
      // Keep Tab inside the open menu.
      const items = [...nav.querySelectorAll<HTMLElement>('a[href], button')].filter(
        (el) => el.offsetParent !== null
      );
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Never leave the menu (or the scroll lock) stuck open: on rotating or
    // resizing into the desktop layout, or on coming back via the back button.
    desktop.addEventListener('change', () => setOpen(false));
    window.addEventListener('pageshow', () => setOpen(false));
  }
</script>
