---
/**
 * The approved brand mark, copied from the concept rather than redrawn.
 *
 * Construction: the Stella d'Italia is the wheel's hub; the emblem's cogwheel
 * is a tyre with 16 tread teeth and five spokes, one per point of the star;
 * a red ribbon across the foot carries the name.
 *
 * Variants:
 *   emblem   full mark with the ribbon — print, signage, Open Graph
 *   icon     wheel and star only, no ribbon — the ribbon drops out below
 *            120px per the concept, so the header and favicons use this
 * Each has a reversed form for the dark greens.
 *
 * The accessible name comes from the surrounding link text wherever this sits
 * inside one, so `title` is opt-in: passing it adds role="img" and a <title>,
 * leaving it out marks the SVG aria-hidden.
 */
interface Props {
  variant?: 'emblem' | 'icon';
  reversed?: boolean;
  title?: string;
  class?: string;
}

const {
  variant = 'icon',
  reversed = false,
  title,
  class: className,
} = Astro.props;

// Reversed swaps the tyre and rim for the dark-green ground; the star keeps
// its white fill and red outline in both, which is what holds the mark
// together across backgrounds.
const tyre = reversed ? '#F4F5F0' : '#1C1F1D';
const rimFill = reversed ? '#0F2A1E' : '#FFFFFF';
const rimStroke = reversed ? '#5CC48C' : '#008C45';
const spoke = rimStroke;

const isEmblem = variant === 'emblem';
const viewBox = isEmblem ? '0 0 200 190' : '14 14 172 172';
// The star carries a slightly heavier outline at icon sizes so it survives
// the reduction, exactly as the concept steps it up.
const starStroke = isEmblem ? 4 : 5;

const TEETH = Array.from({ length: 16 }, (_, i) => i * 22.5);
const SPOKES = [
  [100, 66, 100, 46],
  [132.3, 89.5, 151.4, 83.3],
  [120, 127.5, 131.7, 143.7],
  [80, 127.5, 68.3, 143.7],
  [67.7, 89.5, 48.6, 83.3],
] as const;

const STAR =
  '100,66 108.2,88.7 132.3,89.5 113.3,104.3 120,127.5 100,114 80,127.5 86.7,104.3 67.7,89.5 91.8,88.7';
---

{/* Intrinsic size, so the mark reserves its box before CSS arrives and the
    header never reflows around it. Any width rule overrides it. */}
<svg
  class={className}
  viewBox={viewBox}
  width={isEmblem ? 200 : 172}
  height={isEmblem ? 190 : 172}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}

  {/* Tread teeth */}
  <g fill={tyre}>
    {
      TEETH.map((deg) => (
        <rect
          x="95"
          y="20"
          width="10"
          height="9"
          rx="1.5"
          transform={deg === 0 ? undefined : `rotate(${deg} 100 100)`}
        />
      ))
    }
  </g>

  {/* Tyre wall and inner rim */}
  <circle cx="100" cy="100" r="66" fill="none" stroke={tyre} stroke-width="14"
  ></circle>
  <circle
    cx="100"
    cy="100"
    r="57"
    fill={rimFill}
    stroke={rimStroke}
    stroke-width="3"></circle>

  {/* Five spokes, aligned to the star's points */}
  <g stroke={spoke} stroke-width="6" stroke-linecap="round">
    {
      SPOKES.map(([x1, y1, x2, y2]) => (
        <line x1={x1} y1={y1} x2={x2} y2={y2} />
      ))
    }
  </g>

  {/* Stella d'Italia as the hub */}
  <polygon
    points={STAR}
    fill="#FFFFFF"
    stroke="#CD212A"
    stroke-width={starStroke}
    stroke-linejoin="round"></polygon>

  {
    isEmblem && (
      <>
        {/* Ribbon tails and folds */}
        <polygon points="4,154 30,154 30,182 4,182 13,168" fill="#9E1A21" />
        <polygon
          points="196,154 170,154 170,182 196,182 187,168"
          fill="#9E1A21"
        />
        <polygon points="22,174 30,182 30,174" fill="#6E1016" />
        <polygon points="178,174 170,182 170,174" fill="#6E1016" />

        {/* Ribbon band */}
        <rect x="22" y="146" width="156" height="28" fill="#CD212A" />
        <line
          x1="26"
          y1="149.5"
          x2="174"
          y2="149.5"
          stroke="#FFFFFF"
          stroke-width=".75"
          opacity=".5"
        />
        <line
          x1="26"
          y1="170.5"
          x2="174"
          y2="170.5"
          stroke="#FFFFFF"
          stroke-width=".75"
          opacity=".5"
        />
        <text
          x="100"
          y="163.8"
          text-anchor="middle"
          font-family="'Manrope Variable', Manrope, 'Segoe UI', Arial, sans-serif"
          font-weight="800"
          font-size="10"
          letter-spacing="1.6"
          fill="#FFFFFF"
        >
          CIAO ITALIAN TAXI
        </text>
      </>
    )
  }
</svg>
