---
import HeroPhoto from '../HeroPhoto.astro';
import heroPhoto from '../../assets/home/private-chauffeur-transfer-italy.webp';
import { altFor } from '../../data/image-alt';
import Icon from '../Icon.astro';
import CtaBand from '../CtaBand.astro';
import Tricolore from '../Tricolore.astro';
import { t } from '../../data/content';
import { meta } from '../../data/seo';
import { routes, ui, type Lang } from '../../data/i18n';
import { emailHref } from '../../data/site.mjs';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).home;
const l = ui[lang];
const h1 = meta.home[lang].h1;

const labels =
  lang === 'en'
    ? {
        from: 'From',
        to: 'To',
        time: 'Typical time',
        price: 'From',
        coverage: 'Across Italy',
        services: 'Services',
        how: 'How it works',
        routes: 'Routes',
        why: 'Why us',
        faq: 'FAQ',
      }
    : {
        from: 'Da',
        to: 'A',
        time: 'Tempo indicativo',
        price: 'Da',
        coverage: 'In tutta Italia',
        services: 'Servizi',
        how: 'Come funziona',
        routes: 'Tratte',
        why: 'Perché noi',
        faq: 'Domande',
      };

const heroAlt = altFor('private-chauffeur-transfer-italy', lang);
---

<!-- Hero -->
<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__col">
      <p class="eyebrow">
        <Tricolore />
        <span class="label">{labels.coverage}</span>
      </p>
      <h1>{h1}</h1>
      <p class="lead">{c.heroLead}</p>

      <div class="btn-row">
        <a class="btn btn--primary" href={`${routes.contact[lang]}#quote-form`}>
          <Icon name="tag" />
          {l.getQuote}
        </a>
        <a class="btn btn--outline" href={emailHref}>
          <Icon name="mail" />
          {l.emailUs}
        </a>
      </div>

      <ul class="hero__trust">
        {
          c.heroTrust.map((item) => (
            <li>
              <Icon name="check" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero__media">
      {/* The chauffeur stands left of centre, so the crop is pulled left to keep
          him and the open door in frame on narrow screens. */}
      <HeroPhoto src={heroPhoto} alt={heroAlt} position="21% 50%" />
    </figure>
  </div>
</section>

<!-- Trust strip -->
{/* Round 1's "Why us" section, drawn as the concept's trust strip. The concept
    shows no heading here, so the eyebrow and h2 are kept for the outline and
    screen readers but hidden visually; every string and heading level is
    unchanged from round 1. */}
<section class="trust-strip" aria-labelledby="why-heading">
  <div class="visually-hidden">
    <p>{labels.why}</p>
    <h2 id="why-heading">{c.whyHeading}</h2>
  </div>
  <ul class="wrap">
    {
      c.why.map((item) => (
        <li>
          <Icon name={item.icon} />
          <div>
            <h3 class="trust-strip__title">{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<!-- Services -->
<section class="section" aria-labelledby="services-heading">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">
        <span class="label">{labels.services}</span>
      </p>
      <h2 id="services-heading">{c.servicesHeading}</h2>
    </div>

    <div class="card-grid">
      {
        c.services.map((service) => (
          <article class="card">
            <Icon name={service.icon} class="card__icon" />
            <h3>{service.title}</h3>
            <p>{service.body}</p>
            <ul class="card__list">
              {service.points.map((point) => (
                <li>
                  <Icon name="check" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- How it works -->
<section class="section section--tint" aria-labelledby="how-heading">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">
        <span class="label">{labels.how}</span>
      </p>
      <h2 id="how-heading">{c.howHeading}</h2>
    </div>

    <ol class="steps">
      {
        c.how.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- Routes -->
<section class="section" aria-labelledby="routes-heading">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">
        <span class="label">{labels.routes}</span>
      </p>
      <h2 id="routes-heading">{c.routesHeading}</h2>
      <p>{c.routesLead}</p>
    </div>

    <div class="routes__scroll">
      <table class="routes">
        <caption>{c.routesNote}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.from}</th>
            <th scope="col">{labels.to}</th>
            <th scope="col">{labels.time}</th>
            <th scope="col">{labels.price}</th>
          </tr>
        </thead>
        <tbody>
          {
            c.routes.map((route) => (
              <tr>
                <th scope="row">{route.from}</th>
                <td>{route.to}</td>
                <td>{route.time}</td>
                <td>
                  <span class="placeholder">{route.price}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- FAQ. Matches the FAQPage JSON-LD emitted by the page that renders this. -->
<section class="section section--tint" aria-labelledby="faq-heading">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">
        <span class="label">{labels.faq}</span>
      </p>
      <h2 id="faq-heading">{c.faqHeading}</h2>
    </div>

    <div class="faq">
      {
        c.faq.map((item) => (
          <details>
            <summary>
              <span>{item.q}</span>
              <Icon name="chevron-down" class="faq__chevron" />
            </summary>
            <div>
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<CtaBand lang={lang} />
