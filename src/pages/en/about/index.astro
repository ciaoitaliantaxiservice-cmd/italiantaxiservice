---
import Base from '../../../layouts/Base.astro';
import AboutBody from '../../../components/sections/AboutBody.astro';
import { meta, alternatesForRoute } from '../../../data/seo';
import { routes, ui } from '../../../data/i18n';

const lang = 'en' as const;
const m = meta.about[lang];

const crumbs = [
  { name: ui[lang].home, path: routes.home[lang] },
  { name: ui[lang].about, path: routes.about[lang] },
];
---

<Base
  lang={lang}
  title={m.title}
  description={m.description}
  path={routes.about[lang]}
  alternates={alternatesForRoute('about')}
  altPaths={routes.about}
  current="about"
  crumbs={crumbs}
>
  <AboutBody lang={lang} />
</Base>
