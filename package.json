{
  "name": "ciao-italian-taxi-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-assets.mjs && next dev",
    "build": "node scripts/build-assets.mjs && next build && node scripts/postbuild.mjs",
    "start": "npx serve@14.2.4 dist",
    "check": "tsc --noEmit",
    "fonts": "node scripts/copy-fonts.mjs",
    "verify": "node scripts/verify-seo.mjs",
    "audit": "npm run build && npm run verify",
    "icons": "node scripts/outline-logo-text.mjs && node scripts/make-icons.mjs",
    "assets": "npm run fonts && npm run icons"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "flowbite": "4.0.2",
    "leaflet": "1.9.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.19.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "fontkitten": "1.0.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
