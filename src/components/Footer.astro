---
import LogoEmblem from './LogoEmblem.astro';
import Placeholders from './Placeholders.astro';
import Tricolore from './Tricolore.astro';
import { routes, navOrder, ui, otherLang, htmlLang, type Lang } from '../data/i18n';
import { cities, cityPath } from '../data/cities';
import { site, emailHref } from '../data/site.mjs';

interface Props {
  lang: Lang;
  altPaths: Record<Lang, string>;
}

const { lang, altPaths } = Astro.props;
const l = ui[lang];
const other = otherLang(lang);
const year = new Date().getFullYear();

const blurb =
  lang === 'en'
    ? 'Private transfers and chauffeured rides between Italian airports, cities and coastal towns, 24 hours a day, 7 days a week.'
    : 'Transfer privati e servizi con autista fra aeroporti, città e località costiere italiane, 24 ore su 24, 7 giorni su 7.';
---

{/* Content, headings and links are exactly as in round 1 (copy and internal
    linking are frozen); only the presentation follows the concept: the
    tricolore cap, the reversed lockup, label-style column headings, and the
    hairline legal bar. */}
<footer class="site-footer">
  {/* The page's one full-width tricolore, capping the footer. */}
  <Tricolore variant="band" />

  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      {/* The full emblem, reversed for the dark ground: Bianco gear, Verde
          Chiaro wheel, name on the ribbon (160px, above the 150px minimum). */}
      <div class="site-footer__lockup">
        <LogoEmblem lang={lang} reversed loading="lazy" />
        <h2 class="site-footer__name">{site.brand}</h2>
      </div>
      <p>{blurb}</p>
      <p>
        <a href={altPaths[other]} hreflang={htmlLang[other]} lang={htmlLang[other]}>
          {l.viewInItalian}
        </a>
      </p>
    </div>

    <div class="site-footer__col">
      <h2 class="label">{l.quickLinks}</h2>
      <ul>
        {navOrder.map((key) => <li><a href={routes[key][lang]}>{l[key]}</a></li>)}
        {
          cities.slice(0, 3).map((city) => (
            <li><a href={cityPath(city, lang)}>{city.name[lang]}</a></li>
          ))
        }
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="label">{l.getInTouch}</h2>
      <ul>
        <li>
          {l.email}: <a href={emailHref}><Placeholders text={site.email} /></a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__legal">
    <span>&copy; {year} <Placeholders text={site.legalName} />. {l.footerLegal}</span>
    <span>{l.vat}: <Placeholders text={site.vatNumber} /></span>
  </div>
</footer>
