---
import '../styles/fonts.css';
// Tailwind + Flowbite entry; it imports global.css and components.css into
// cascade layers. See the comment at the top of main.css.
import '../styles/main.css';

import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import HeadIcons from '../components/HeadIcons.astro';

import { ui, htmlLang, type Lang, type RouteKey } from '../data/i18n';
import type { Alternate } from '../data/seo';
import {
  graph,
  organizationSchema,
  localBusinessSchema,
  webSiteSchema,
  breadcrumbSchema,
  type Crumb,
} from '../data/schema';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** This page's own path — becomes the self-referencing canonical. */
  path: string;
  /** Reciprocal hreflang set, including self and x-default. */
  alternates: Alternate[];
  /** Equivalent page per language, for the header/footer language switch. */
  altPaths: Record<Lang, string>;
  current?: RouteKey;
  noindex?: boolean;
  /** Omit on the homepage, where a single-item breadcrumb adds nothing. */
  crumbs?: Crumb[];
  /** Page-specific nodes, e.g. FAQPage. Merged into the same @graph. */
  extraSchema?: unknown[];
  ogImage?: string;
}

const {
  lang,
  title,
  description,
  path,
  alternates,
  altPaths,
  current,
  noindex = false,
  crumbs,
  extraSchema = [],
  ogImage,
} = Astro.props;

const nodes: unknown[] = [
  organizationSchema(lang),
  localBusinessSchema(lang),
  webSiteSchema(lang),
  ...(crumbs && crumbs.length > 1 ? [breadcrumbSchema(crumbs)] : []),
  ...extraSchema,
];

const jsonLd = JSON.stringify(graph(nodes));
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Seo
      lang={lang}
      title={title}
      description={description}
      path={path}
      alternates={alternates}
      noindex={noindex}
      ogImage={ogImage}
    />

    {/* All three faces render above the fold (hero headline, body, labels),
        so all three are preloaded to keep the swap off the critical path. */}
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-latin-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-latin-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <HeadIcons />
    {/* Matches the utility bar, which is what sits under the status bar. */}
    <meta name="theme-color" content="#0F2A1E" />

    {/* One @graph per page: Organization, LocalBusiness, WebSite, plus
        BreadcrumbList and any page-specific node such as FAQPage. */}
    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">{ui[lang].skipToContent}</a>

    <Header lang={lang} current={current} altPaths={altPaths} />

    {crumbs && crumbs.length > 1 && <Breadcrumbs lang={lang} crumbs={crumbs} />}

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} altPaths={altPaths} />
    <MobileBar lang={lang} />
  </body>
</html>
