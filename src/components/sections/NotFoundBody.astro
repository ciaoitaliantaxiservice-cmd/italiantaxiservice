---
import Tricolore from '../Tricolore.astro';
import { t } from '../../data/content';
import { meta } from '../../data/seo';
import { routes, navOrder, ui, type Lang } from '../../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).notFound;
const l = ui[lang];
---

<section class="section">
  <div class="wrap wrap--narrow notfound">
    <p class="eyebrow" style="justify-content: center">
      <Tricolore />
      <span class="label">404</span>
    </p>
    <h1 style="margin-top: var(--s-4)">{meta.notFound[lang].h1}</h1>
    <p class="lead" style="margin: var(--s-4) auto 0">{c.lead}</p>

    <h2 style="margin-top: var(--s-14)">{c.linksHeading}</h2>
    <div class="notfound__links">
      {
        navOrder.map((key) => (
          <a class="btn btn--outline" href={routes[key][lang]}>
            {l[key]}
          </a>
        ))
      }
    </div>
  </div>
</section>
