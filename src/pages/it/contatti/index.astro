---
import Base from '../../../layouts/Base.astro';
import ContactBody from '../../../components/sections/ContactBody.astro';
import { meta, alternatesForRoute } from '../../../data/seo';
import { routes, ui } from '../../../data/i18n';

const lang = 'it' as const;
const m = meta.contact[lang];

const crumbs = [
  { name: ui[lang].home, path: routes.home[lang] },
  { name: ui[lang].contact, path: routes.contact[lang] },
];
---

<Base
  lang={lang}
  title={m.title}
  description={m.description}
  path={routes.contact[lang]}
  alternates={alternatesForRoute('contact')}
  altPaths={routes.contact}
  current="contact"
  crumbs={crumbs}
>
  <ContactBody lang={lang} />
</Base>
