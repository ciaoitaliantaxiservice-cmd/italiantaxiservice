---
/**
 * Every icon on the site, from Lucide (https://lucide.dev).
 *
 * Rendered at build time as inline SVG: no icon font, no client JavaScript,
 * and only the icons mapped below are imported (one module each).
 *
 * One size and one stroke width across the site: 24px, Lucide's native grid,
 * at a 1.5 stroke, the concept's line weight. The size is set by the .icon
 * class (--icon-size in global.css), never per context. Colour is
 * currentColor, so an icon takes the brand colour of the text it sits in.
 *
 * Decorative: Lucide marks the SVG aria-hidden, because every icon on the site
 * sits next to a text label that already says what it means.
 */
import Check from '@lucide/astro/icons/check';
import Tag from '@lucide/astro/icons/tag';
import MapPin from '@lucide/astro/icons/map-pin';
import Car from '@lucide/astro/icons/car';
import Clock from '@lucide/astro/icons/clock';
import Plane from '@lucide/astro/icons/plane';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import MessagesSquare from '@lucide/astro/icons/messages-square';
import Mail from '@lucide/astro/icons/mail';
// Lucide ships no brand logos; message-circle is its chat glyph and keeps the
// same stroke style as every other icon, which a filled brand mark would not.
import MessageCircle from '@lucide/astro/icons/message-circle';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import type { IconName } from '../data/icons';

interface Props {
  name: IconName;
  class?: string;
}

const ICONS = {
  check: Check,
  tag: Tag,
  'map-pin': MapPin,
  car: Car,
  clock: Clock,
  plane: Plane,
  'shield-check': ShieldCheck,
  messages: MessagesSquare,
  mail: Mail,
  whatsapp: MessageCircle,
  menu: Menu,
  close: X,
  'chevron-down': ChevronDown,
} satisfies Record<IconName, unknown>;

const { name, class: className } = Astro.props;
const Lucide = ICONS[name];
---

<Lucide
  size={24}
  stroke-width={1.5}
  class={['icon', className].filter(Boolean).join(' ')}
  focusable="false"
/>
