---
import { t } from '../data/content';
import { type Lang } from '../data/i18n';
import { FORM_ENDPOINT } from '../data/site.mjs';

interface Props {
  lang: Lang;
  /** Rendered as the form's accessible name. */
  heading: string;
  /** Heading level so the form slots into each page's outline correctly. */
  headingLevel?: 2 | 3;
  note?: string;
}

const { lang, heading, headingLevel = 2, note } = Astro.props;
const f = t(lang).form;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

const today = new Date().toISOString().slice(0, 10);
---

<form
  class="form"
  id="quote-form"
  method="post"
  action={FORM_ENDPOINT || undefined}
  novalidate
  data-quote-form
  data-endpoint={FORM_ENDPOINT}
  aria-labelledby="quote-form-heading"
>
  <div class="form__head">
    <Heading id="quote-form-heading">{heading}</Heading>
    {note && <span class="note">{note}</span>}
  </div>

  {/* Error summary. Populated by script, focused on failed submit. */}
  <div
    class="form__status form__status--error"
    id="form-errors"
    role="alert"
    tabindex="-1"
    data-error-summary
    hidden
  >
    <strong>{f.errors.summary}</strong>
    <ul></ul>
  </div>

  <div class="form__row form__row--2">
    <div class="field">
      <label for="qf-name">
        {f.name} <span class="field__hint">({f.required})</span>
      </label>
      <input
        type="text"
        id="qf-name"
        name="name"
        autocomplete="name"
        required
        aria-describedby="qf-name-error"
      />
      <p class="field__error" id="qf-name-error" data-error-for="qf-name">
        {f.errors.name}
      </p>
    </div>

    <div class="field">
      <label for="qf-email">
        {f.email} <span class="field__hint">({f.required})</span>
      </label>
      <input
        type="email"
        id="qf-email"
        name="email"
        autocomplete="email"
        required
        aria-describedby="qf-email-error"
      />
      <p class="field__error" id="qf-email-error" data-error-for="qf-email">
        {f.errors.email}
      </p>
    </div>
  </div>

  <div class="form__row form__row--2">
    <div class="field">
      <label for="qf-phone">
        {f.phone} <span class="field__hint">({f.required})</span>
      </label>
      <input
        type="tel"
        id="qf-phone"
        name="phone"
        autocomplete="tel"
        required
        aria-describedby="qf-phone-error"
      />
      <p class="field__error" id="qf-phone-error" data-error-for="qf-phone">
        {f.errors.phone}
      </p>
    </div>

    <div class="field">
      <label for="qf-service">{f.service}</label>
      <select id="qf-service" name="service">
        {f.serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
      </select>
    </div>
  </div>

  <div class="form__row form__row--2">
    <div class="field">
      <label for="qf-pickup">
        {f.pickup} <span class="field__hint">({f.required})</span>
      </label>
      <input
        type="text"
        id="qf-pickup"
        name="pickup"
        required
        aria-describedby="qf-pickup-error"
      />
      <p class="field__error" id="qf-pickup-error" data-error-for="qf-pickup">
        {f.errors.pickup}
      </p>
    </div>

    <div class="field">
      <label for="qf-dropoff">
        {f.dropoff} <span class="field__hint">({f.required})</span>
      </label>
      <input
        type="text"
        id="qf-dropoff"
        name="dropoff"
        required
        aria-describedby="qf-dropoff-error"
      />
      <p class="field__error" id="qf-dropoff-error" data-error-for="qf-dropoff">
        {f.errors.dropoff}
      </p>
    </div>
  </div>

  <div class="form__row form__row--3">
    <div class="field">
      <label for="qf-date">
        {f.date} <span class="field__hint">({f.required})</span>
      </label>
      <input
        type="date"
        id="qf-date"
        name="date"
        min={today}
        required
        aria-describedby="qf-date-error"
      />
      <p class="field__error" id="qf-date-error" data-error-for="qf-date">
        {f.errors.date}
      </p>
    </div>

    <div class="field">
      <label for="qf-time">
        {f.time} <span class="field__hint">({f.optional})</span>
      </label>
      <input type="time" id="qf-time" name="time" />
    </div>

    <div class="field">
      <label for="qf-passengers">{f.passengers}</label>
      <input
        type="number"
        id="qf-passengers"
        name="passengers"
        min="1"
        max="16"
        value="2"
        inputmode="numeric"
      />
    </div>

    <div class="field">
      <label for="qf-luggage">{f.luggage}</label>
      <input
        type="number"
        id="qf-luggage"
        name="luggage"
        min="0"
        max="20"
        value="2"
        inputmode="numeric"
      />
    </div>
  </div>

  <div class="field">
    <label for="qf-flight">
      {f.flight} <span class="field__hint">({f.optional})</span>
    </label>
    <input type="text" id="qf-flight" name="flight" aria-describedby="qf-flight-help" />
    <p class="field__hint" id="qf-flight-help">{f.flightHelp}</p>
  </div>

  <div class="field">
    <label for="qf-notes">
      {f.notes} <span class="field__hint">({f.optional})</span>
    </label>
    <textarea id="qf-notes" name="notes" rows="4" aria-describedby="qf-notes-help"
    ></textarea>
    <p class="field__hint" id="qf-notes-help">{f.notesHelp}</p>
  </div>

  <div class="field field--check">
    <input
      type="checkbox"
      id="qf-consent"
      name="consent"
      value="yes"
      required
      aria-describedby="qf-consent-error"
    />
    <label for="qf-consent">{f.consent}</label>
    <p class="field__error" id="qf-consent-error" data-error-for="qf-consent">
      {f.errors.consent}
    </p>
  </div>

  {/* Honeypot: bots fill it, people never see it. */}
  <div class="visually-hidden" aria-hidden="true">
    <label for="qf-company">Company</label>
    <input type="text" id="qf-company" name="_company" tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="language" value={lang} />

  <div>
    <button class="btn btn--primary btn--lg" type="submit">{f.submit}</button>
  </div>

  <div class="form__status form__status--info" data-unconfigured role="status" hidden>
    {f.unconfigured}
  </div>

  <div class="form__status form__status--success" data-success role="status" hidden>
    {f.success}
  </div>
</form>

<script>
  // Client-side validation. Native constraints do the checking; this layer
  // exists for the error summary, the per-field messages and focus management,
  // which the browser's own bubbles do not provide accessibly.
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');

  if (form) {
    const summary = form.querySelector<HTMLElement>('[data-error-summary]');
    const summaryList = summary?.querySelector('ul');
    const unconfigured = form.querySelector<HTMLElement>('[data-unconfigured]');
    const success = form.querySelector<HTMLElement>('[data-success]');
    const endpoint = form.dataset.endpoint || '';

    const controls = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        'input[required], select[required], textarea[required]'
      )
    );

    const messageFor = (el: HTMLElement) =>
      form.querySelector<HTMLElement>(`[data-error-for="${el.id}"]`);

    const showFieldError = (el: HTMLElement, show: boolean) => {
      el.setAttribute('aria-invalid', show ? 'true' : 'false');
      const msg = messageFor(el);
      if (msg) msg.dataset.visible = show ? 'true' : 'false';
    };

    // Clear a field's error as soon as it becomes valid again.
    controls.forEach((el) => {
      el.addEventListener('blur', () => {
        if (el.checkValidity()) showFieldError(el, false);
      });
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true' && el.checkValidity()) {
          showFieldError(el, false);
        }
      });
    });

    form.addEventListener('submit', (event) => {
      const invalid = controls.filter((el) => !el.checkValidity());

      controls.forEach((el) => showFieldError(el, invalid.includes(el)));

      if (invalid.length > 0) {
        event.preventDefault();

        if (summary && summaryList) {
          summaryList.innerHTML = '';
          invalid.forEach((el) => {
            const li = document.createElement('li');
            const link = document.createElement('a');
            link.href = `#${el.id}`;
            link.textContent = messageFor(el)?.textContent ?? el.id;
            link.addEventListener('click', (e) => {
              e.preventDefault();
              el.focus();
            });
            li.appendChild(link);
            summaryList.appendChild(li);
          });
          summary.hidden = false;
          summary.focus();
        }
        return;
      }

      if (summary) summary.hidden = true;

      // No endpoint configured yet: keep the data in front of the user and
      // point them at a channel that actually reaches someone.
      if (!endpoint) {
        event.preventDefault();
        if (unconfigured) {
          unconfigured.hidden = false;
          unconfigured.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
        return;
      }

      if (success) success.hidden = false;
    });
  }
</script>
