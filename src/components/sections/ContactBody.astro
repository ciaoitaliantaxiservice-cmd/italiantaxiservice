---
import Icon from '../Icon.astro';
import QuoteForm from '../QuoteForm.astro';
import Placeholders from '../Placeholders.astro';
import Tricolore from '../Tricolore.astro';
import CoverageMap from '../CoverageMap.astro';
import { t } from '../../data/content';
import { meta } from '../../data/seo';
import { ui, type Lang } from '../../data/i18n';
import { site, emailHref } from '../../data/site.mjs';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).contact;
const l = ui[lang];
const h1 = meta.contact[lang].h1;

const addressLines = [
  site.address.street,
  `${site.address.postalCode} ${site.address.city}`,
  site.address.region,
];
---

<section class="section">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">
        <Tricolore />
        <span class="label">{lang === 'en' ? 'Contact' : 'Contatti'}</span>
      </p>
      <h1>{h1}</h1>
      <p>{c.lead}</p>
    </div>

    <div class="contact-grid">
      <div>
        <QuoteForm lang={lang} heading={c.formHeading} headingLevel={2} note={c.formNote} />
      </div>

      <div class="stack">
        {/* Requests come in through the form or by email only. */}
        <div>
          <h2>{c.methodsHeading}</h2>
          <p class="muted" style="margin-top: var(--s-2)">{c.methodsNote}</p>
          <ul class="method-list" style="margin-top: var(--s-4)">
            <li>
              <a class="method" href={emailHref}>
                <Icon name="mail" />
                <span>
                  <span class="method__label">{l.email}</span>
                  <span class="method__value">
                    <Placeholders text={site.email} />
                  </span>
                </span>
              </a>
            </li>
          </ul>
        </div>

        <div class="panel">
          <h2 class="title-sm">{c.hoursHeading}</h2>
          <p style="margin-top: var(--s-2)">{c.hoursBody}</p>
          <p class="muted" style="margin-top: var(--s-2)">{c.hoursMore}</p>
        </div>

        <div class="panel">
          <h2 class="title-sm">{c.responseHeading}</h2>
          <p style="margin-top: var(--s-2)">{c.responseBody}</p>
        </div>

        <div class="panel">
          <h2 class="title-sm">{c.addressHeading}</h2>
          <address style="margin-top: var(--s-2); font-style: normal" class="muted">
            <Placeholders text={site.legalName} /><br />
            {
              addressLines.map((line) => (
                <Fragment>
                  <Placeholders text={line} />
                  <br />
                </Fragment>
              ))
            }
            {l.vat}: <Placeholders text={site.vatNumber} />
          </address>
        </div>
      </div>
    </div>
  </div>
</section>

<CoverageMap lang={lang} />
